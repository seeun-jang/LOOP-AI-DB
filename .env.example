# scripts/setup_env.py creates unique local passwords and a signing key.
# Do not commit .env. These examples must be replaced before starting.
POSTGRES_DB=loop_ai
POSTGRES_USER=loop_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgresql://loop_app:CHANGE_ME@127.0.0.1:5433/loop_ai
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=60
# demo works offline with clearly labeled fixed educational examples.
AI_PROVIDER=demo
GEMINI_API_KEY=
# Set an available generateContent model ID from your Google AI Studio account.
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=30
